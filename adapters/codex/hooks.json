{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${FLOW_HOOKS_DIR}/session-start.mjs\" --tool codex",
            "timeout": 10
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${FLOW_HOOKS_DIR}/guard-frozen.mjs\" --tool codex",
            "timeout": 5
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${FLOW_HOOKS_DIR}/stop.mjs\" --tool codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
